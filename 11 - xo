# Game-Playing Agent using Minimax Algorithm

import math

board = [' '] * 9

def check_winner(b):
    wins = [
        (0,1,2), (3,4,5), (6,7,8),
        (0,3,6), (1,4,7), (2,5,8),
        (0,4,8), (2,4,6)
    ]

    for a, b1, c in wins:
        if b[a] == b[b1] == b[c] and b[a] != ' ':
            return b[a]

    return None

def minimax(b, is_max):
    winner = check_winner(b)

    if winner == 'O':
        return 1
    if winner == 'X':
        return -1
    if ' ' not in b:
        return 0

    if is_max:
        best = -math.inf

        for i in range(9):
            if b[i] == ' ':
                b[i] = 'O'
                best = max(best, minimax(b, False))
                b[i] = ' '

        return best

    else:
        best = math.inf

        for i in range(9):
            if b[i] == ' ':
                b[i] = 'X'
                best = min(best, minimax(b, True))
                b[i] = ' '

        return best

def display():
    for i in range(0, 9, 3):
        print('|'.join(board[i:i+3]))
        if i < 6:
            print('-----')

def ai_move():
    best = -math.inf
    move = -1

    for i in range(9):
        if board[i] == ' ':
            board[i] = 'O'
            score = minimax(board, False)
            board[i] = ' '

            if score > best:
                best = score
                move = i

    board[move] = 'O'

print("TIC TAC TOE")
print("You are X and AI is O")

while True:
    display()

    move = int(input("Enter position (1-9): ")) - 1

    if move < 0 or move > 8 or board[move] != ' ':
        print("Invalid move! Try again.")
        continue

    board[move] = 'X'

    if check_winner(board) == 'X':
        display()
        print("You win!")
        break

    if ' ' not in board:
        display()
        print("Game Draw!")
        break

    ai_move()

    if check_winner(board) == 'O':
        display()
        print("AI Wins!")
        break

    if ' ' not in board:
        display()
        print("Game Draw!")
        break