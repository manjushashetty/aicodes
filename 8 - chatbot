# Rule-Based Chatbot with Pattern Matching

def chatbot():
    print("Chatbot: Hello! I am your assistant.")
    print("Chatbot: Type 'bye' to exit.")

    while True:
        user = input("You: ").lower()

        if "hello" in user or "hi" in user:
            print("Chatbot: Hello! How can I help you?")

        elif "name" in user:
            print("Chatbot: I am a rule-based chatbot.")

        elif "how are you" in user:
            print("Chatbot: I am doing great! Thank you.")

        elif "college" in user:
            print("Chatbot: College is a place to learn and grow.")

        elif "bye" in user:
            print("Chatbot: Goodbye! Have a nice day.")
            break

        else:
            print("Chatbot: Sorry, I don't understand.")

chatbot()