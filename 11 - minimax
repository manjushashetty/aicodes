# Minimax Algorithm

def minimax(node, depth, maximizing):

    if depth == 0 or isinstance(node, int):
        return node

    if maximizing:
        best = float('-inf')

        for child in node:
            value = minimax(child, depth-1, False)
            best = max(best, value)

        return best

    else:
        best = float('inf')

        for child in node:
            value = minimax(child, depth-1, True)
            best = min(best, value)

        return best


tree = [[1, 2, 3], [4, 5, 6]]

result = minimax(tree, 2, True)

print("Result:", result)